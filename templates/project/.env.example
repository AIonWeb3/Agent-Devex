# Copy to `.env` and fill in secrets. Never commit `.env`.

# Source account alias or public key used by stellar-cli deploy
STELLAR_ACCOUNT=

# Secret key for the MCP server signer (starts with S)
STELLAR_SECRET_KEY=

# Contract ID after `agent-devex deploy` (starts with C)
AGENTPAY_CONTRACT_ID=

# Optional RPC overrides (defaults are Stellar testnet)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
