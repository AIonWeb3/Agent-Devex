# Copy to `.env` and fill in secrets. Never commit `.env`.

# Stellar RPC and network
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Source account alias or public key used by stellar-cli deploy
STELLAR_ACCOUNT=

# Secret key for the MCP server signer (starts with S)
STELLAR_SECRET_KEY=

# Soroban contract IDs (placeholders until deploy)
AGENTPAY_CONTRACT_ID=
SOROBAN_CONTRACT_ID=

# AI provider keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
