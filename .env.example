# Agent-Devex Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Stellar Configuration ───────────────────────────────────────────
# Secret key for signing transactions (required for deploy and MCP server)
# Generate a testnet keypair at: https://laboratory.stellar.org/#account-creator
# STELLAR_SECRET_KEY=S...

# Source account name for stellar-cli deploy operations
# STELLAR_ACCOUNT=my-testnet-account

# ─── Contract Configuration ──────────────────────────────────────────
# Contract ID after deployment (required for MCP server)
# AGENTPAY_CONTRACT_ID=C...

# ─── Network Configuration (optional) ───────────────────────────────
# Soroban RPC endpoint (default: testnet)
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (default: Test SDF Network ; September 2015)
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ─── Development Configuration (optional) ───────────────────────────
# Logging verbosity: TRACE, DEBUG, INFO, WARN, ERROR
# RUST_LOG=info

# Disable colored output
# NO_COLOR=1
