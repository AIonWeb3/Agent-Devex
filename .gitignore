# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which we don't want
*.pdb

# Generated WASM artifacts
*.wasm

# macOS
.DS_Store

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Environment files (secrets)
.env
.env.local
.env.*.local

# Node.js (generated projects)
node_modules/

# Python (generated projects)
__pycache__/
*.pyc
.venv/

# Test output
test-project/
test-output/
tmp/
